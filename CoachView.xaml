<UserControl x:Class="VocalTuner.CoachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VocalTuner"
             xmlns:coach="clr-namespace:VocalTuner.Coach">
  <StackPanel>
    <Border Style="{StaticResource Card}" Padding="22,18">
      <StackPanel>
        <TextBlock x:Name="IntroTitle" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="IntroTxt" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,4,0,16"/>
        <WrapPanel>
          <Button x:Name="TakeBtn" Style="{StaticResource Pill}" Margin="0,0,10,8"/>
          <Button x:Name="FileBtn" Style="{StaticResource Secondary}" Margin="0,0,10,8"/>
        </WrapPanel>
        <TextBlock x:Name="StatusTxt" FontSize="12.5" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderB}" Margin="0,14,0,0" Padding="0,12,0,0">
          <StackPanel>
            <DockPanel Margin="0,4">
              <TextBlock x:Name="VoiceLbl" Style="{StaticResource Label}"/>
              <local:Dropdown x:Name="VoiceSel" Width="210" HorizontalAlignment="Left"/>
            </DockPanel>
            <DockPanel Margin="0,4">
              <TextBlock x:Name="LangLbl" Style="{StaticResource Label}"/>
              <Border Background="{DynamicResource Muted}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="LangEn" Style="{StaticResource Seg}" GroupName="coachlang" Content="English"/>
                  <RadioButton x:Name="LangTh" Style="{StaticResource Seg}" GroupName="coachlang" Content="ไทย" Margin="3,0,0,0"/>
                </StackPanel>
              </Border>
            </DockPanel>
            <DockPanel Margin="0,4">
              <TextBlock x:Name="BackLbl" Style="{StaticResource Label}"/>
              <Button x:Name="BackClear" DockPanel.Dock="Right" Style="{StaticResource Link}" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="BackClearTxt" FontSize="12" Foreground="{DynamicResource Sub}" TextDecorations="Underline"/>
              </Button>
              <Button x:Name="BackBtn" Style="{StaticResource Link}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="BackTxt" FontSize="12.5" Foreground="{DynamicResource Text}" TextDecorations="Underline" TextTrimming="CharacterEllipsis"/>
              </Button>
            </DockPanel>
            <TextBlock x:Name="BackHint" Style="{StaticResource Hint}" Margin="116,2,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <DockPanel Margin="0,26,0,8">
      <TextBlock x:Name="HistCount" DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Bottom"/>
      <TextBlock x:Name="HistTitle" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}"/>
    </DockPanel>
    <Border x:Name="TrendBox" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="TrendTitle" FontSize="12" Foreground="{DynamicResource Sub}"/>
        <coach:ChartView x:Name="Trend" Height="110" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel x:Name="HistList"/>
    <TextBlock x:Name="HistEmpty" Style="{StaticResource Hint}" FontSize="12.5"/>

    <TextBlock x:Name="TipsTxt" Style="{StaticResource Hint}" Margin="0,22,0,0"/>
  </StackPanel>
</UserControl>
