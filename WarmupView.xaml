<UserControl x:Class="VocalTuner.WarmupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VocalTuner">
  <StackPanel>

    <!-- setup -->
    <Border Style="{StaticResource Card}" Padding="22,18">
      <StackPanel>
        <DockPanel Margin="0,0,0,6">
          <TextBlock Style="{StaticResource Label}" Text="Exercise"/>
          <Border Background="{DynamicResource Muted}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ExFive" Style="{StaticResource Seg}" GroupName="warmex" Content="5-note scale"/>
              <RadioButton x:Name="ExArp" Style="{StaticResource Seg}" GroupName="warmex" Content="Arpeggio" Margin="3,0,0,0"/>
            </StackPanel>
          </Border>
        </DockPanel>
        <TextBlock x:Name="PatternTxt" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Sub}" Margin="116,2,0,10"/>

        <DockPanel Margin="0,5">
          <TextBlock Style="{StaticResource Label}" Text="Start note"/>
          <local:Dropdown x:Name="StartSel" Width="96"/>
          <TextBlock Text="up to" FontSize="13" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="12,0"/>
          <local:Dropdown x:Name="TopSel" Width="96"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button x:Name="PresetLow" Style="{StaticResource Link}" ToolTip="C3 up to A3">
              <TextBlock Text="lower voice" FontSize="12" Foreground="{DynamicResource Sub}" TextDecorations="Underline"/>
            </Button>
            <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="8,0"/>
            <Button x:Name="PresetHigh" Style="{StaticResource Link}" ToolTip="C4 up to G4">
              <TextBlock Text="higher voice" FontSize="12" Foreground="{DynamicResource Sub}" TextDecorations="Underline"/>
            </Button>
          </StackPanel>
        </DockPanel>

        <DockPanel Margin="0,5">
          <TextBlock Style="{StaticResource Label}" Text="Speed"/>
          <TextBlock x:Name="BpmVal" DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11.5" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
          <local:HSlider x:Name="BpmSl" Min="40" Max="180" Step="2" Default="100"/>
        </DockPanel>
        <DockPanel Margin="0,5">
          <TextBlock Style="{StaticResource Label}" Text="Piano volume"/>
          <TextBlock x:Name="VolVal" DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11.5" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
          <local:HSlider x:Name="VolSl" Min="0" Max="100" Step="1" Default="70"/>
        </DockPanel>

        <WrapPanel Margin="116,8,0,0">
          <CheckBox x:Name="DownChk" Content="Come back down" Margin="0,0,22,6"/>
          <CheckBox x:Name="MelodyChk" Content="Piano plays the notes with you" Margin="0,0,0,6"
                    ToolTip="Off: only the starting chord plays, and you sing the pattern on your own"/>
        </WrapPanel>
        <TextBlock x:Name="PlanTxt" Style="{StaticResource Hint}" Margin="116,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- start / stop -->
    <Button x:Name="GoBtn" Style="{StaticResource Pill}" HorizontalAlignment="Center" MinWidth="200" Padding="30,12" FontSize="15" Margin="0,22,0,0">
      <StackPanel Orientation="Horizontal">
        <Path x:Name="GoIcon" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="12" Stretch="Uniform"
              Data="M0,0 L10,6 L0,12 Z" VerticalAlignment="Center"/>
        <TextBlock x:Name="GoLbl" Text="Start warm-up" Margin="10,0,0,0" FontWeight="SemiBold"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </StackPanel>
    </Button>
    <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" Margin="0,8,0,0"
               Text="Space starts and stops · wear headphones so the mic hears only you"/>

    <!-- live -->
    <Grid Margin="0,24,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="SING" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock x:Name="TargetEl" Text="—" FontSize="44" FontWeight="Medium" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          <TextBlock x:Name="RoundTxt" FontSize="12.5" Foreground="{DynamicResource Sub}" VerticalAlignment="Bottom" Margin="14,0,0,10"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock Text="YOU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Right">
          <TextBlock x:Name="YouCents" Style="{StaticResource Mono}" FontSize="14" Foreground="{DynamicResource Faint}" VerticalAlignment="Bottom" Margin="0,0,12,10" Text="— ¢"/>
          <TextBlock x:Name="YouEl" Text="—" FontSize="44" FontWeight="Medium" FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{DynamicResource Off}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <StackPanel x:Name="Chips" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    <local:TunerBar x:Name="WBar" Height="40" Margin="0,16,0,0"/>
    <local:PitchRoll x:Name="WRoll" Height="260" Margin="0,16,0,0" ShowNoteBlocks="False"/>
  </StackPanel>
</UserControl>
