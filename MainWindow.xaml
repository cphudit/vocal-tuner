<Window x:Class="VocalTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VocalTuner"
        Title="Vocal Tuner" Width="860" Height="1000" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel MaxWidth="680" Margin="24,30,24,40">

      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Vocal Tuner" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="Subtitle" Text="Sing, check your pitch, record" FontSize="12.5" Foreground="{DynamicResource Sub}" Margin="0,2,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Muted}" CornerRadius="19" Padding="4" VerticalAlignment="Center" Margin="12,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TabTuner" Style="{StaticResource Tab}" GroupName="page" Content="Tuner"/>
            <RadioButton x:Name="TabPiano" Style="{StaticResource Tab}" GroupName="page" Content="Piano" Margin="4,0,0,0"/>
            <RadioButton x:Name="TabWarm" Style="{StaticResource Tab}" GroupName="page" Content="Warm-up" Margin="4,0,0,0"/>
            <RadioButton x:Name="TabCoach" Style="{StaticResource Tab}" GroupName="page" Content="Coach" Margin="4,0,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource Off}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusTxt" Style="{StaticResource Mono}" Text="starting…" Margin="8,0,14,0" VerticalAlignment="Center" MinWidth="64"/>
          <Button x:Name="ThemeBtn" Style="{StaticResource Icon}" ToolTip="Light mode">
            <Grid>
              <Path x:Name="IconMoon" Stroke="{DynamicResource Sub}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M21,12.79 A9,9 0 1 1 11.21,3 A7,7 0 0 0 21,12.79 Z"/>
              <Grid x:Name="IconSun" Width="16" Height="16">
                <Ellipse Width="7" Height="7" Stroke="{DynamicResource Sub}" StrokeThickness="1.6"/>
                <Path Stroke="{DynamicResource Sub}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                      Data="M12,2 V4 M12,20 V22 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 H4 M20,12 H22 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93"/>
              </Grid>
            </Grid>
          </Button>
          <Button x:Name="SettingsBtn" Style="{StaticResource Icon}" ToolTip="Settings" Margin="10,0,0,0">
            <Path Stroke="{DynamicResource Sub}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" StrokeLineJoin="Round"
                  Data="M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z M19.4,15 A1.65,1.65 0 0 0 19.73,16.82 L19.79,16.88 A2,2 0 1 1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0 0 15.08,19.32 A1.65,1.65 0 0 0 14.08,20.83 V21 A2,2 0 1 1 10.08,21 V20.91 A1.65,1.65 0 0 0 9.08,19.4 A1.65,1.65 0 0 0 7.26,19.73 L7.2,19.79 A2,2 0 1 1 4.37,16.96 L4.43,16.9 A1.65,1.65 0 0 0 4.76,15.08 A1.65,1.65 0 0 0 3.25,14.08 H3 A2,2 0 1 1 3,10.08 H3.09 A1.65,1.65 0 0 0 4.6,9.08 A1.65,1.65 0 0 0 4.27,7.26 L4.21,7.2 A2,2 0 1 1 7.04,4.37 L7.1,4.43 A1.65,1.65 0 0 0 8.92,4.76 H9 A1.65,1.65 0 0 0 10,3.25 V3 A2,2 0 1 1 14,3 V3.09 A1.65,1.65 0 0 0 15,4.6 A1.65,1.65 0 0 0 16.82,4.27 L16.88,4.21 A2,2 0 1 1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0 0 19.32,8.92 V9 A1.65,1.65 0 0 0 20.83,10 H21 A2,2 0 1 1 21,14 H20.91 A1.65,1.65 0 0 0 19.4,15 Z"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ======================= Tuner page ======================= -->
      <StackPanel x:Name="PageTuner" Margin="0,30,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" MinHeight="120">
          <TextBlock x:Name="NoteEl" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="112" FontWeight="Medium"
                     Foreground="{DynamicResource Off}" VerticalAlignment="Bottom" LineHeight="112" LineStackingStrategy="BlockLineHeight"/>
          <TextBlock x:Name="OctaveEl" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40" Foreground="{DynamicResource Faint}"
                     VerticalAlignment="Bottom" Margin="4,0,0,4"/>
          <StackPanel VerticalAlignment="Bottom" Margin="18,0,0,14">
            <TextBlock x:Name="CentsEl" Style="{StaticResource Mono}" Text="— ¢" FontSize="15" Foreground="{DynamicResource Faint}"/>
            <TextBlock x:Name="HzEl" Style="{StaticResource Mono}" Text="— Hz" FontSize="13" Margin="0,6,0,0"/>
          </StackPanel>
        </StackPanel>

        <local:TunerBar x:Name="Bar" Height="64" Margin="0,26,0,0"/>
        <Grid Margin="0,10,0,0">
          <TextBlock Style="{StaticResource Mono}" Text="-50¢ flat" FontSize="11" Foreground="{DynamicResource Faint}"/>
          <TextBlock Style="{StaticResource Mono}" Text="in tune" FontSize="11" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
          <TextBlock Style="{StaticResource Mono}" Text="+50¢ sharp" FontSize="11" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right"/>
        </Grid>

        <local:PitchRoll x:Name="Trace" Height="320" Margin="0,30,0,0"/>
        <Grid x:Name="MetersGrid" Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock Style="{StaticResource Mono}" Text="voice" FontSize="10.5" Foreground="{DynamicResource Faint}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <local:LevelMeter x:Name="MicMeter" Height="6" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel x:Name="BackMeterRow" Grid.Column="2" Visibility="Hidden">
            <TextBlock Style="{StaticResource Mono}" Text="backing" FontSize="10.5" Foreground="{DynamicResource Faint}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <local:LevelMeter x:Name="BackMeter" Height="6" VerticalAlignment="Center" Backing="True"/>
          </DockPanel>
        </Grid>

        <!-- record controls (where "Start listening" used to be) -->
        <Grid Margin="0,26,0,0" HorizontalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="RecTimer" Style="{StaticResource Mono}" Text="0:00.0" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"/>
          <Button x:Name="RecBtn" Grid.Column="1" Style="{StaticResource Pill}" MinWidth="172" Padding="30,12" FontSize="15">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="RecIcon" Width="11" Height="11" CornerRadius="5.5" Background="{DynamicResource Red}" VerticalAlignment="Center"/>
              <TextBlock x:Name="RecLbl" Text="Record" Margin="10,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold"/>
              <Border x:Name="RecKeyCap" Margin="12,0,0,0" Padding="6,1" CornerRadius="5" BorderThickness="1" Opacity="0.55" VerticalAlignment="Center"
                      BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                <TextBlock x:Name="RecKeyTxt" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Border>
            </StackPanel>
          </Button>
          <TextBlock x:Name="RecState" Grid.Column="2" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="22,0,0,0"/>
        </Grid>
        <Button x:Name="RecSummary" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,8,0,0" ToolTip="Change recording setup">
          <TextBlock x:Name="RecSummaryText" FontSize="12" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
        </Button>
        <Button x:Name="LastTakeBtn" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed" ToolTip="Open the review window again">
          <TextBlock x:Name="LastTakeText" FontSize="12" Foreground="{DynamicResource Sub}"/>
        </Button>
        <TextBlock x:Name="MicErr" Visibility="Collapsed" FontSize="13" Foreground="{DynamicResource Err}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0">
          Microphone not available. Check that a microphone is connected and allowed in Windows privacy settings. Retrying automatically…
        </TextBlock>
        <TextBlock x:Name="RecErr" Visibility="Collapsed" FontSize="13" Foreground="{DynamicResource Err}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>

      </StackPanel>

      <!-- ======================= Piano page ======================= -->
      <StackPanel x:Name="PagePiano" Margin="0,30,0,0" Visibility="Collapsed">
        <Border Background="{DynamicResource Muted}" CornerRadius="12" Padding="18,14">
          <DockPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="PNote" Text="—" FontSize="34" FontWeight="Medium" MinWidth="68" FontFamily="Segoe UI Variable Display, Segoe UI"/>
              <TextBlock x:Name="PCents" Style="{StaticResource Mono}" Text="— ¢" Foreground="{DynamicResource Faint}" VerticalAlignment="Bottom" Margin="12,0,0,8"/>
            </StackPanel>
            <local:TunerBar x:Name="PBar" Height="16" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <DockPanel Margin="0,24,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="OctDown" Style="{StaticResource Square}" Content="−"/>
            <TextBlock x:Name="OctLabel" Style="{StaticResource Mono}" Foreground="{DynamicResource Text}" FontSize="13" Width="80" TextAlignment="Center" VerticalAlignment="Center" Text="C3 – C5"/>
            <Button x:Name="OctUp" Style="{StaticResource Square}" Content="+"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
            <Path Stroke="{DynamicResource Sub}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" StrokeLineJoin="Round" StrokeEndLineCap="Round"
                  Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5"/>
            <local:HSlider x:Name="PianoVol" Width="120" Margin="8,0" Min="0" Max="100" Default="70"/>
            <TextBlock x:Name="PianoVolVal" Style="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Faint}" Width="34" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Click keys or use your computer keyboard" FontSize="13.5" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <local:PianoKeyboard x:Name="Keyboard" Height="250" Margin="6,24,6,0"/>
        <Button x:Name="PianoOut" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,16,0,0" ToolTip="Choose where the sound plays">
          <TextBlock x:Name="PianoOutText" FontSize="12" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
        </Button>
        <Button x:Name="PianoKeysLink" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,22,0,0" ToolTip="Choose which computer keys play each note and shift the octave">
          <TextBlock x:Name="PianoHint" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Faint}"/>
        </Button>
      </StackPanel>

      <!-- ======================= Warm-up page ======================= -->
      <StackPanel>
        <local:WarmupView x:Name="PageWarm" Margin="0,30,0,0" Visibility="Collapsed"/>
        <local:CoachView x:Name="PageCoach" Margin="0,30,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
